# Public HTTPS entry point. Replace the host name with your own domain if you have one.
70-34-209-197.sslip.io {
	encode gzip

	# E-commerce storefront (React build with base /mockup/, talks to the real API).
	redir /mockup /mockup/
	handle_path /mockup/* {
		root * /opt/app/BlackBear/frontend/dist-mockup
		file_server
	}

	# The earlier static, clickable design mockup (example data).
	redir /mockup-static /mockup-static/
	handle_path /mockup-static/* {
		root * /opt/app/BlackBear/web/mockup
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:8000 {
			flush_interval -1
		}
	}
}
