# Base URL of the FastAPI backend. Empty = same origin (in dev, Vite proxies /api).
# Example: VITE_API_BASE=https://blackbear-api.example.com
VITE_API_BASE=

# "true" (default) replays a scripted hunt in the browser with no backend.
# Set to "false" to talk to the real API.
VITE_USE_MOCK=true

# Dev server only: where /api is proxied when VITE_API_BASE is empty.
# Not exposed to the browser bundle.
BLACKBEAR_PROXY_TARGET=http://localhost:8000
